{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->
        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> {{modelName}} List</h4>
            <a href="/dynamic/{{modelName}}/add" class="btn btn-primary waves-effect waves-light mb-2">Add New</a>

            <!-- Table for displaying dynamic model items -->
            <div class="card">
              <div class="card-datatable text-nowrap">
                <table class="table responsive">
                  <thead>
                    <tr>
                      {{#each fields}}
                        <th>{{this.name}}</th>
                      {{/each}}
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each items}}
                      <tr>
                        {{#each ../fields}}
                          <td>{{lookup ../this this.name}}</td>
                        {{/each}}
                        <td>
                          <a href="/dynamic/{{../modelName}}/edit/{{this._id}}" class="btn btn-sm btn-primary">Edit</a>
                          <form action="/dynamic/{{../modelName}}/delete/{{this._id}}" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                          </form>
                        </td>
                      </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          {{>adminfooter}}
        </div>
      </div>
    </div>
  </div>
</body>

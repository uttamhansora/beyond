{{> adminhead}}

<body>
  <div class="layout-wrapper">
    {{> adminsidebar}}
    <div class="layout-page">
      <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
          <h4 class="py-3 mb-4">
            <span class="text-muted fw-light">Dashboard /</span>
            {{#if entry}}Edit Entry{{else}}Create Entry{{/if}}
          </h4>
          <div class="card mb-4">
            <div class="card-body">
              <form action="/lDevelopmentCenter" method="post" enctype="multipart/form-data">
                {{#if entry._id}}
                  <input type="hidden" name="id" value="{{entry._id}}">
                {{/if}}
                
                <div class="mb-3">
                  <label class="form-label">Heading</label>
                  <input type="text" name="heading" class="form-control" value="{{entry.heading}}">
                </div>
                
                <div class="mb-3">
                  <label class="form-label">Title</label>
                  <input type="text" name="title" class="form-control" value="{{entry.title}}">
                </div>
                
                <div class="mb-3">
                  <label class="form-label">Image Title</label>
                  <input type="text" name="image_title" class="form-control" value="{{entry.image_title}}">
                </div>

                <div class="mb-3">
                  <label class="form-label">Image</label>
                  <input type="file" name="image" class="form-control">
                  {{#if entry.image}}
                    <a href="{{entry.image}}" target="_blank">View Image</a>
                  {{/if}}
                </div>

                <div class="mb-3">
                  <label class="form-label">Title2</label>
                  <input type="text" name="title2" class="form-control" value="{{entry.title2}}">
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
              </form>
            </div>
          </div>
        </div>
        {{> adminfooter}}
      </div>
    </div>
  </div>
</body>

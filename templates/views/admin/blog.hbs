        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createblog';
  }

$(document).ready(function() {
  $('#blogs-table').DataTable({
    "processing": true,
    "serverSide": true,
    "ajax": {
      "url": $('#blogs-table').data('url'),
      "type": "GET"
    },
    "columns": [
      { "data": "name" },
     {
  "data": "is_latest",
  "render": function(data, type, row) {
    let checked = data ? "checked" : "";
    return `<input type="checkbox" class="toggle-latest" data-id="${row._id}" data-field="is_latest" ${checked}>`;
  }
},
{
  "data": "is_home_latest",
  "render": function(data, type, row) {
    let checked = data ? "checked" : "";
    return `<input type="checkbox" class="toggle-latest" data-id="${row._id}" data-field="is_home_latest" ${checked}>`;
  }
},
      { 
        "data": "_id",
        "render": function(data, type, row) {
          return `
            <button type="button" class="btn btn-sm btn-primary" onclick="editBlog('${data}')">Edit</button>
            <button type="button" class="btn btn-sm btn-danger" onclick="deleteBlog('${data}')">Delete</button>
          `;
        }
      }
    ]
  });

 $('#blogs-table').on('change', '.toggle-latest', function() {
  const blogId = $(this).data('id');
  const field = $(this).data('field'); // "is_latest" or "is_home_latest"

  $.post($('#blogs-table').data('url'), { id: blogId, field }, function(res) {
    if (!res.success) {
      alert(res.error);
    }
    $('#blogs-table').DataTable().ajax.reload(null, false);
  });
});
});

  function editBlog(id) {
    window.location.href = '{{url}}createblog/' + id;
  }

  function deleteBlog(id) {
    if (confirm('Are you sure you want to delete this Blog?')) {
                      $.ajax({
                        url: `/deleteblog/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#blogs-table').DataTable().ajax.reload();
                          alert('Product deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting product:', err);
                          alert('Error deleting product');
                        }
                      });
                    }
  }
</script>
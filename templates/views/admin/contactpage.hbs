    <script>
        $('#refresh').click(function () {
            $.ajax({
                url: '/testimonial',
                method: 'GET',
                success: function (data) {
                    var select = $('#testimonials');
                    select.empty();
                    select.append('<option label=" "></option>');
                    $.each(data, function (index, category) {
                        select.append('<option value="' + category._id + '">' + category.t_name + '</option>');
                    });
                }
            });
        });

        $('#createCategory').click(function () {
            $('#categoryModal').modal('show');
        });

        $('#saveJourneyButton').click(function () {
            // Create a new FormData object to store form data
            var t_name = $("#t_name").val()
            var t_description = $("#t_description").val()

            // Make an AJAX request to the server
            $.ajax({
                url: '/testimonial/create', // Update with your server route
                method: 'POST',
                data: { t_description: t_description, t_name: t_name },

                success: function (response) {
                    console.log('Testimonial created successfully:', response);
                    $('#categoryModal').modal('hide'); // Close modal after success
                    $('#refresh').click(); // Trigger a refresh of UI elements
                    // Optionally update or refresh UI elements as needed
                },
                error: function (err) {
                    console.error('Error creating testimonial:', err);
                    // Handle error responses from the server
                }
            });
        });
        $(".delete-btn").click(function () {
            var filename = $(this).data('filename');
            var fieldname = $(this).data('fieldname');
            var modelname = 'Home';
            $.ajax({
                url: "/deleteimage",
                method: "POST",
                data: { filename: filename, fieldname: fieldname, modelname: modelname },
                success: function (res) {
                    location.reload();
                }
            })
        })
    </script>

    <input type="text" name="competencies_title" class="form-control" id="competencies_title" placeholder="Competencies Title" value="{{about.competencies_title}}" />
</div>
<div class="mb-3">
    <label class="form-label" for="competencies_description">Competencies Description</label>
    <textarea name="competencies_description" class="form-control" id="competencies_description" placeholder="Competencies Description">{{about.competencies_description}}</textarea>
</div>

<!-- Process Section -->
<div class="mb-3">
    <label class="form-label" for="process_title">Process Title</label>
    <input type="text" name="process_title" class="form-control" id="process_title" placeholder="Process Title" value="{{about.process_title}}" />
</div>
<div class="mb-3">
    <label class="form-label" for="process_description">Process Description</label>
    <textarea name="process_description" class="form-control" id="process_description" placeholder="Process Description">{{about.process_description}}</textarea>
</div>
 <div class="mb-3">
                        <label class="form-label" for="basic-default-fullname">Application Title</label>
                        <input type="text" name="application_title" class="form-control" value="{{about.application_title}}" id="basic-default-fullname"
                          placeholder="Application Title" />
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-message">Application Description</label>
                        <textarea id="editor2" class="form-control" name="application_description" placeholder="Content">{{about.application_description}}</textarea>
                      </div>

                      <!-- Submit Button -->
                      <button type="submit" class="btn btn-primary">Submit</button>
                      <a href="/dashboard" class="btn btn-danger">Cancel</a>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{> adminfooter}}
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript for auto-generating the slug -->
  <script>
    function generateSlug() {
      var name = document.querySelector('input[name="name"]').value;
      var slugField = document.querySelector('input[name="slug"]');
      
      // Generate slug by converting name to lowercase and replacing spaces with hyphens
      var slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      
      // Set the generated slug in the slug field
      slugField.value = slug;
    }
  </script>
    <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor2'), {
                  autoGrow: false, // Disable auto grow
                  // Your other CKEditor configuration options...
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
</body>

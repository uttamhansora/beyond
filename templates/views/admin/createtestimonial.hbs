{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Create Testimonial
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/storetestimonial" method="post" enctype="multipart/form-data">
                     {{#if team._id}}
  <input type="hidden" name="id" value="{{team._id}}">
  {{/if}}

  <div class="mb-3">
    <label class="form-label" for="basic-default-fullname">Select Format</label>
    <select class="form-control" name="format" id="format-select">
      <option value="Description">Description</option>
      <option value="Youtube">Youtube Link</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label" for="basic-default-fullname">Select Category</label>
    <select class="select2 form-control" id="category_id" name="category_id">
                                          <option label=" "></option>
                                          {{#each category}}
                                          <option value="{{this._id}}" {{#if_eq this._id ../team.category_id}}selected
                                             {{/if_eq}}>{{this.name}}</option>
                                          {{/each}}
                                       </select>
  </div>

    <div class="mb-3">
      <label class="form-label" for="basic-default-name">Name</label>
      <input type="text" name="name" class="form-control" value="{{team.name}}" id="basic-default-name" placeholder="Name" />
    </div>
    <div class="mb-3">
      <label class="form-label" for="basic-default-position">Position</label>
      <input type="text" name="position" class="form-control" value="{{team.position}}" id="basic-default-position" placeholder="Position" />
    </div>
     <div class="mb-3">
      <label class="form-label" for="basic-default-image">Image</label>
      <input type="file" name="image" class="form-control">
      {{#if team.image}}
      <a href="javascript:void(0)" image-path="{{team.image}}" class="openimage ">View Image</a>
      {{/if}}
    </div>

  <!-- Fields for "Description" format -->
  <div id="description-fields" style="display: none;">
    

   
    <div class="mb-3">
      <label class="form-label" for="basic-default-description">Description</label>
      <textarea id="editor-description" class="form-control" name="description" placeholder="Description">{{team.description}}</textarea>
    </div>
  </div>
<div class="mb-3">
      <label class="form-label" for="basic-default-client-logo">Client Logo</label>
      <input type="file" name="client_logo" class="form-control">
      {{#if team.client_logo}}
      <a href="javascript:void(0)" image-path="{{team.client_logo}}" class="openimage">View Logo</a>
      {{/if}}
    </div>
  <!-- Fields for "Youtube Link" format -->
  <div id="youtube-fields" style="display: none;">
    


    <div class="mb-3">
      <label class="form-label" for="basic-default-youtube-link">YouTube Link</label>
      <input type="url" name="youtube_link" class="form-control" value="{{team.youtube_link}}" id="basic-default-youtube-link" placeholder="YouTube Link" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                  </div>
                </div>
              </div>

            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false, // Disable auto grow
                  // Your other CKEditor configuration options...
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
          <script>
  document.addEventListener('DOMContentLoaded', function () {
    const formatSelect = document.getElementById('format-select');
    const descriptionFields = document.getElementById('description-fields');
    const youtubeFields = document.getElementById('youtube-fields');

    // Show the correct fields based on initial selection
    toggleFields(formatSelect.value);

    // Listen to the change event on the select dropdown
    formatSelect.addEventListener('change', function () {
      toggleFields(this.value);
    });

    function toggleFields(format) {
      if (format === 'Description') {
        descriptionFields.style.display = 'block';
        youtubeFields.style.display = 'none';
      } else if (format === 'Youtube') {
        descriptionFields.style.display = 'none';
        youtubeFields.style.display = 'block';
      }
    }
  });
</script>
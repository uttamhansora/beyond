{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard /</span> Create Talent Assessment
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/storeTalentAssement" method="post" enctype="multipart/form-data">
                      {{#if team._id}}
                      <input type="hidden" name="id" value="{{team._id}}">
                      {{/if}}

                      <!-- Title -->
                      <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" name="title" class="form-control" value="{{team.title}}" placeholder="Title" />
                      </div>

                      <!-- Heading -->
                      <div class="mb-3">
                        <label class="form-label">Heading</label>
                        <input type="text" name="heading" class="form-control" value="{{team.heading}}" placeholder="Heading" />
                      </div>

                      <!-- Image -->
                      <div class="mb-3">
                        <label class="form-label">Image</label>
                        <input type="file" name="image" class="form-control">
                        {{#if team.image}}
                        <a href="javascript:void(0)" image-path="{{team.image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <!-- Description -->
                      <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" placeholder="Description">{{team.description}}</textarea>
                      </div>

                      <!-- Download File -->
                      <div class="mb-3">
                        <label class="form-label">Download File</label>
                        <input type="file" name="download_file" class="form-control">
                        {{#if team.download_file}}
                        <a href="javascript:void(0)" file-path="{{team.download_file}}" class="openfile">View File</a>
                        {{/if}}
                      </div>

                      <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{>adminfooter}}
        </div>
      </div>
    </div>
  </div>
</body>

{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Home Page Settings
            </h4>
            <div class="row">
              <div class="col-md-12">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/homepagestore" method="POST" enctype="multipart/form-data">
                      <input type="hidden" name="id" value="66fb7e2d419c8a43da4967cc">

                      <!-- Video -->
<div class="mb-3">
  <label class="form-label" for="video"><strong>Video</strong></label>
  <input type="file" name="video" class="form-control" accept="video/*" {{#if home.video}}{{else}}required{{/if}} />
  {{#if home.video}}
    <a href="{{home.video}}" target="_blank">View Video</a>
  {{/if}}
</div>

<!-- Title -->
<div class="mb-3">
  <label class="form-label" for="title"><strong>Title</strong></label>
  <input type="text" name="title" class="form-control" value="{{home.title}}" placeholder="Enter Title" required />
</div>

<!-- Small Title -->
<div class="mb-3">
  <label class="form-label" for="small_title"><strong>Small Title</strong></label>
  <input type="text" name="small_title" class="form-control" value="{{home.small_title}}" placeholder="Enter Small Title" required />
</div>

<div class="mb-3">
  <label class="form-label" for="small_description">
    <strong>Small Description</strong>
  </label>
  <textarea
    name="small_description"
    class="form-control"
    rows="3"
    placeholder="Enter Small Description"
  >{{home.small_description}}</textarea>
</div>
<!-- Link 1 Title -->
<div class="mb-3">
  <label class="form-label" for="link_1_title">
    <strong>Link 1 Title</strong>
  </label>
  <input
    type="text"
    name="link_1_title"
    class="form-control"
    value="{{home.link_1_title}}"
    placeholder="Enter Link 1 Title"
  />
</div>

<!-- Link 1 URL -->
<div class="mb-3">
  <label class="form-label" for="link_1_link">
    <strong>Link 1 URL</strong>
  </label>
  <input
    type="url"
    name="link_1_link"
    class="form-control"
    value="{{home.link_1_link}}"
    placeholder="https://example.com"
  />
</div>

<!-- Link 2 Title -->
<div class="mb-3">
  <label class="form-label" for="link_2_title">
    <strong>Link 2 Title</strong>

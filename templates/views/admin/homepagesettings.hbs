    placeholder="Enter Link 2 Title"
  />
</div>

<!-- Link 2 URL -->
<div class="mb-3">
  <label class="form-label" for="link_2_link">
    <strong>Link 2 URL</strong>
  </label>
  <input
    type="url"
    name="link_2_link"
    class="form-control"
    value="{{home.link_2_link}}"
    placeholder="https://example.com"
  />
</div>

                      <!-- Section 1 Heading -->

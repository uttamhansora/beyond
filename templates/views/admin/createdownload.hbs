{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Create Download
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/storedownload" method="post" enctype="multipart/form-data">
                    {{#if team._id}}
                    <input type="hidden" name="id" value="{{team._id}}">
                    {{/if}}
                   
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-fullname">Title</label>
                        <input type="text" name="title" class="form-control" value="{{team.title}}" id="basic-default-fullname"
                          placeholder="Title" />
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-company">Image</label>
                        <input type="file" name="image" class="form-control">
                         {{#if team.image}}
                                                            <a href="javascript:void(0)" image-path="{{team.image}}"
                                                                class="openimage ">View
                                                                Image</a>
                                                            {{/if}}
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-company">Download Image</label>
                        <input type="file" name="download_file" class="form-control">
                        {{#if team.download_file}}
                                                            <a href="javascript:void(0)" image-path="{{team.download_file}}"
                                                                class="openimage ">View
                                                                File</a>
                                                            {{/if}}
                      </div>
                      <div class="mb-3">
                          <label class="form-label" for="basic-default-company">Youtube Link</label>
                        <input type="text" name="video_link" class="form-control" value="{{team.video_link}}">
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-message">Description</label>
                        <textarea  class="form-control" name="description" placeholder="Description">{{team.description}}</textarea>
                      </div>
                      <button type="submit" class="btn btn-primary">Submit</button>
                      <a href="/dashboard" class="btn btn-danger">Cancel</a>
                    </form>
                  </div>
                </div>
              </div>

            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false, // Disable auto grow
                  // Your other CKEditor configuration options...
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
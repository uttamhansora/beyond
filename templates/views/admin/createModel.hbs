{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Create New Model
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <h1>Create New Model</h1>
                    <form action="/createmodels" method="POST" >
                      <!-- Model Name Input -->
                      <div class="mb-3">
                        <label class="form-label" for="modelName">Model Name</label>
                        <input type="text" name="modelName" class="form-control" id="modelName" placeholder="Model Name" required />
                      </div>

                      <!-- Field Container -->
                      <div id="fieldContainer">
                        <div class="field">
                          <input type="text" name="fieldNames[]" placeholder="Field Name" required class="form-control mb-3" />
                          <select name="fieldTypes[]" class="form-select mb-3">
                            <option value="String">Text</option>
                            <option value="Number">Number</option>
                            <option value="Date">Date</option>
                            <option value="Textarea">Textarea</option>
                            <option value="TextareaEditor">Textarea (Editor)</option>
                            <option value="File">File</option>
                          </select>
                          <label><input type="checkbox" name="fieldRequired[]" value="0"> Required</label>
                        </div>
                      </div>

                      <!-- Buttons -->
                      <button type="button" class="btn btn-secondary" onclick="addField()">Add Field</button>
                      <button type="submit" class="btn btn-primary">Create Model</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{>adminfooter}}
          
          <!-- CKEditor Script -->
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false, // Disable auto grow
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });

            // Function to add new fields dynamically
            let fieldCount = 1;

            function addField() {
              const fieldContainer = document.getElementById('fieldContainer');
              const newField = document.createElement('div');
              newField.className = 'field';
              newField.innerHTML = `
                <input type="text" name="fieldNames[]" placeholder="Field Name" required class="form-control mb-3" />
                <select name="fieldTypes[]" class="form-select mb-3">
                  <option value="String">Text</option>
                  <option value="Number">Number</option>
                  <option value="Date">Date</option>
                  <option value="Textarea">Textarea</option>
                   <option value="TextareaEditor">Textarea (Editor)</option>
                  <option value="File">File</option>
                </select>
                <label><input type="checkbox" name="fieldRequired[]" value="${fieldCount}"> Required</label>
              `;
              fieldContainer.appendChild(newField);
              fieldCount++;
            }
          </script>
        </div>
      </div>
    </div>
  </div>
</body>

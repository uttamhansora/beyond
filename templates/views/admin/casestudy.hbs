        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createcasestudy';
  }

  $(document).ready(function() {
    $('#casestudys-table').DataTable({
      "processing": true,
      "serverSide": true,
      "ajax": {
        "url": $('#casestudys-table').data('url'),
        "type": "GET"
      },
      "columns": [
        { "data": "name" },
        
        { "data": "author" },
        { 
          "data": "_id",
          "render": function(data, type, row) {
            return '<button type="button" class="btn btn-sm btn-primary" onclick="editcaseStudy(\'' + data + '\')">Edit</button>' +
                   ' <button type="button" class="btn btn-sm btn-danger" onclick="deletecaseStudy(\'' + data + '\')">Delete</button>';
          }
        }
      ]
    });
  });

  function editcaseStudy(id) {
    window.location.href = '{{url}}createcasestudy/' + id;
  }

  function deletecaseStudy(id) {
    if (confirm('Are you sure you want to delete this case Study?')) {
                      $.ajax({
                        url: `/deletecasestudy/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#casestudys-table').DataTable().ajax.reload();
                          alert('Product deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting product:', err);
                          alert('Error deleting product');
                        }
                      });
                    }
  }
</script>
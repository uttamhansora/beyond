              {{!-- <h5 class="card-header">Ajax Sourced Server-side</h5> --}}

              <div class="card-datatable text-nowrap">
                <table class="table responsive" id="casestudys-table" data-url="casestudys">
                  <thead>
                    <tr>
                      <th>case Study Name</th>

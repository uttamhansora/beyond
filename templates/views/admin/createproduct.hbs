{{>adminhead}}
<link rel="stylesheet" href="../../assets/vendor/libs/node-waves/node-waves.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/typeahead-js/typeahead.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/bs-stepper/bs-stepper.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/bootstrap-select/bootstrap-select.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/select2/select2.css" />
<link rel="stylesheet" href="../../assets/vendor/libs/@form-validation/form-validation.css" />

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->

            {{>adminsidebar}}
            <!-- / Menu -->

            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->

                <!-- / Navbar -->

                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <h4 class="py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> Create Product</h4>

                        <!-- Ajax Sourced Server-side -->


                        <div class="col-12 mb-4">
                            <small class="text-light fw-medium">Enter Product Details</small>
                            <div id="wizard-validation" class="bs-stepper mt-2">
                                <div class="bs-stepper-header">
                                    <div class="step" data-target="#account-details-validation">
                                        <button type="button" class="step-trigger">
                                            <span class="bs-stepper-circle">1</span>
                                            <span class="bs-stepper-label mt-1">
                                                <span class="bs-stepper-title">Basic Details</span>
                                                <span class="bs-stepper-subtitle">Setup Basic Details</span>
                                            </span>
                                        </button>
                                    </div>
                                    <div class="line">
                                        <i class="ti ti-chevron-right"></i>
                                    </div>
                                    <div class="step" data-target="#personal-info-validation">
                                        <button type="button" class="step-trigger">
                                            <span class="bs-stepper-circle">2</span>
                                            <span class="bs-stepper-label">
                                                <span class="bs-stepper-title">Product Description</span>
                                                <span class="bs-stepper-subtitle">Add Product Description</span>
                                            </span>
                                        </button>
                                    </div>
                                    <div class="line">
                                        <i class="ti ti-chevron-right"></i>
                                    </div>
                                    <div class="step" data-target="#social-links-validation">
                                        <button type="button" class="step-trigger">
                                            <span class="bs-stepper-circle">3</span>
                                            <span class="bs-stepper-label">
                                                <span class="bs-stepper-title">Image & Attributes</span>
                                                <span class="bs-stepper-subtitle">Add Image & Attributes</span>
                                            </span>
                                        </button>
                                    </div>

                                </div>
                                <div class="bs-stepper-content">
                                    <form id="wizard-validation-form" action="storeproduct" method="post"
                                        enctype="multipart/form-data">
                                        <!-- Account Details -->
                                        <div id="account-details-validation" class="content">
                                            <div class="content-header mb-3">
                                                <h6 class="mb-0">Product Details</h6>
                                                <small>Enter Your Product Details.</small>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="formValidationUsername">Product
                                                        Name</label>
                                                    <input type="text" name="formValidationUsername" id="product_name"
                                                        class="form-control" placeholder="Product Name" />
                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="ProductSlug">Product Slug</label>
                                                    <input type="text" name="ProductSlug" id="ProductSlug"
                                                        class="form-control" placeholder="Product Slug" readonly />
                                                </div>
                                                <div class="col-sm-6">
                                                    <div style="display: flex;justify-content: space-between;">
                                                        <div><label class="form-label" for="">Category</label></div>
                                                        <div>
                                                            <a href="javascript:void(0)" id="refresh"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-refresh">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path
                                                                        d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                                                                </svg></a>
                                                            <a id="createCategory" href="javascript:void(0)"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                                                                    <path d="M9 12h6" />
                                                                    <path d="M12 9v6" />
                                                                </svg></a>
                                                        </div>

                                                    </div>
                                                    <select class="select2" id="category_id" name="category_id">
                                                        <option label=" "></option>
                                                        {{#each category}}
                                                        <option value="{{this._id}}">{{this.name}}</option>
                                                        {{/each}}
                                                    </select>

                                                </div>
                                                <div class="col-sm-6">
                                                    <label class="form-label" for="ProductPrice">Product Price</label>
                                                    <input type="number" name="ProductPrice" id="ProductPrice"
                                                        class="form-control" placeholder="Product Price" />
                                                </div>

                                                <div class="col-12 d-flex justify-content-between">
                                                    <button type="button" class="btn btn-label-secondary btn-prev"
                                                        disabled>
                                                        <i class="ti ti-arrow-left me-sm-1 me-0"></i>
                                                        <span
                                                            class="align-middle d-sm-inline-block d-none">Previous</span>
                                                    </button>
                                                    <button type="button" class="btn btn-primary btn-next">
                                                        <span
                                                            class="align-middle d-sm-inline-block d-none me-sm-1">Next</span>
                                                        <i class="ti ti-arrow-right"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Personal Info -->
                                        <div id="personal-info-validation" class="content">
                                            <div class="content-header mb-3">
                                                <h6 class="mb-0">Product Description</h6>
                                                <small>Enter Product Description.</small>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-sm-12">
                                                    <label class="form-label" for="formValidationFirstName">Small
                                                        Description</label>
                                                    <textarea class="form-control" name="sub_description"></textarea>
                                                </div>
                                                <div class="col-sm-12">
                                                    <div style="display: flex;justify-content: space-between;">
                                                        <div><label class="form-label" for="">Select Description</label>
                                                        </div>
                                                        <div>
                                                            <a href="javascript:void(0)" id="refreshdescription"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-refresh">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path
                                                                        d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                                                                </svg></a>
                                                            <a id="createdescription" href="javascript:void(0)"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                                                                    <path d="M9 12h6" />
                                                                    <path d="M12 9v6" />
                                                                </svg></a>
                                                        </div>

                                                    </div>
                                                    <select class="form-control select2" id="description_id"
                                                        name="description_id[]" multiple="multiple">
                                                        <option label=" "></option>
                                                        {{#each description}}
                                                        <option value="{{this._id}}">{{this.name}}</option>
                                                        {{/each}}
                                                    </select>
                                                </div>

                                                <div class="col-12 d-flex justify-content-between">
                                                    <button type="button" class="btn btn-label-secondary btn-prev">
                                                        <i class="ti ti-arrow-left me-sm-1 me-0"></i>
                                                        <span
                                                            class="align-middle d-sm-inline-block d-none">Previous</span>
                                                    </button>
                                                    <button type="button" class="btn btn-primary btn-next">
                                                        <span
                                                            class="align-middle d-sm-inline-block d-none me-sm-1">Next</span>
                                                        <i class="ti ti-arrow-right"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Social Links -->
                                        <div id="social-links-validation" class="content">
                                            <div class="content-header mb-3">
                                                <h6 class="mb-0">Image & Attributes</h6>
                                                <small>Enter Your Image & Attributes.</small>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-sm-12">
                                                    <label class="form-label" for="formValidationTwitter">Select
                                                        Image</label>
                                                    <input type="file" name="image" class="form-control">
                                                </div>
                                                <div class="col-sm-12">
                                                    <div id="attributesContainer">
                                                        <!-- Dynamic attributes will be appended here -->
                                                    </div>

                                                    <button type="button" class="btn btn-primary m-2"
                                                        id="addAttribute">Add
                                                        Attribute</button>
                                                </div>

                                                <div class="col-12 d-flex justify-content-between">
                                                    <button type="button" class="btn btn-label-secondary btn-prev">
                                                        <i class="ti ti-arrow-left me-sm-1 me-0"></i>
                                                        <span
                                                            class="align-middle d-sm-inline-block d-none">Previous</span>
                                                    </button>
                                                    <button type="submit"
                                                        class="btn btn-success btn-next btn-submit">Submit</button>
                                                </div>
                                            </div>
                                        </div>

                                    </form>
                                </div>
                            </div>
                        </div>


                    </div>


                    <div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel1">Create Category</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Category Name:</label>
                                            <input type="text" class="form-control" id="categoryName">
                                        </div>
                                    </div>

                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                                        Close
                                    </button>
                                    <button type="button" id="saveCategory" class="btn btn-primary">Save
                                        changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="descriptionModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel1">Create Description</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Name:</label>
                                            <input type="text" class="form-control" id="desc_name">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Description:</label>
                                            <textarea name="desc_desc" id="desc_desc" class="form-control"></textarea>
                                        </div>
                                    </div>

                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                                        Close
                                    </button>
                                    <button type="button" id="savedescription" class="btn btn-primary">Save
                                        changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="attributeModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel1">Create Attibute</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Name:</label>
                                            <input type="text" class="form-control" id="attr_name">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Value:</label>
                                            <input type="text" class="form-control" id="attr_value">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Price:</label>
                                            <input type="number" class="form-control" id="attr_price">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Image:</label>
                                            <input type="file" class="form-control" name="attr_image" id="attr_image">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col mb-3">
                                            <label for="categoryName">Stock (Default ∞):</label>
                                            <input type="number" class="form-control" id="attr_stock">
                                        </div>
                                    </div>


                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">
                                        Close
                                    </button>
                                    <button type="button" id="saveattribute" class="btn btn-primary">Save
                                        changes</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{>adminfooter}}
                    <script>
                        $(document).ready(function () {

                            function generateSlug(str) {
                                return str
                                    .toLowerCase()
                                    .replace(/[^\w\s-]/g, '') // Remove all non-word characters
                                    .trim()
                                    .replace(/\s+/g, '-') // Replace spaces with -
                                    .replace(/-+/g, '-'); // Replace multiple - with single -
                            }
                            $('#product_name').on('input', function () {
                                var slug = generateSlug($(this).val());
                                $('#ProductSlug').val(slug);
                            });
                            $('.select2').select2();

                            $('#refresh').click(function () {
                                $.ajax({
                                    url: '/categories',
                                    method: 'GET',
                                    success: function (data) {
                                        var select = $('#category_id');
                                        select.empty();
                                        select.append('<option label=" "></option>');
                                        $.each(data, function (index, category) {
                                            select.append('<option value="' + category._id + '">' + category.name + '</option>');
                                        });
                                    }
                                });
                            });

                            $('#createCategory').click(function () {
                                $('#categoryModal').modal('show');
                            });

                            $('#saveCategory').click(function () {
                                var categoryName = $('#categoryName').val();
                                $.ajax({
                                    url: '/categoriescreate',
                                    method: 'POST',
                                    data: { name: categoryName },
                                    success: function (data) {
                                        $('#categoryModal').modal('hide');
                                        $('#categoryName').val('');
                                        $('#refresh').click(); // Refresh the categories
                                    }
                                });
                            });
                            $('#refreshdescription').click(function () {
                                $.ajax({
                                    url: '/description',
                                    method: 'GET',
                                    success: function (data) {
                                        var select = $('#description_id');
                                        select.empty();
                                        select.append('<option label=" "></option>');
                                        $.each(data, function (index, category) {
                                            select.append('<option value="' + category._id + '">' + category.name + '</option>');
                                        });
                                    }
                                });
                            });

                            $('#createdescription').click(function () {
                                $('#descriptionModal').modal('show');
                            });

                            $('#savedescription').click(function () {
                                var desc_name = $('#desc_name').val();
                                var desc_desc = $('#desc_desc').val();
                                $.ajax({
                                    url: '/descriptioncreate',
                                    method: 'POST',
                                    data: { name: desc_name, description: desc_desc },
                                    success: function (data) {
                                        $('#descriptionModal').modal('hide');
                                        $('#desc_name').val('');
                                        $('#desc_desc').val('');
                                        $('#refreshdescription').click(); // Refresh the categories
                                    }
                                });
                            });
                            $('#attributesContainer').on('click', '.refreshattribute', function () {
                                $.ajax({
                                    url: '/attribute',
                                    method: 'GET',
                                    success: function (data) {
                                        var select = $('.attribute_id');
                                        select.empty();
                                        select.append('<option label=" "></option>');
                                        $.each(data, function (index, category) {
                                            select.append('<option value="' + category._id + '">' + category.name + '</option>');
                                        });
                                    }
                                });
                            });

                            var attr=1;
                            $('#addAttribute').click(function () {
                                $('#attributesContainer').append(`
                    <div class="attribute">
                        <label for="attributeName"> Parent Attribute Name:</label>
                        <input type="text" class="attributeName form-control" name="attributes[`+attr+`][attr_name]" multiple required>
                        
                        <label for="attributeValue">Select Attribute:</label>
                        <a href="javascript:void(0)" class="refreshattribute"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-refresh">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path
                                                                        d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                                                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                                                                </svg></a>
                                                            <a class="createattribute" href="javascript:void(0)"><svg
                                                                    xmlns="http://www.w3.org/2000/svg" width="24"
                                                                    height="24" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round"
                                                                    class="icon icon-tabler icons-tabler-outline icon-tabler-circle-plus">
                                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                                                                    <path d="M9 12h6" />
                                                                    <path d="M12 9v6" />
                                                                </svg></a>
                        <select name="attributes[`+attr+`][attr_id]" class="form-control select2 attribute_id" multiple required>
                        </select>
                        
                        
                        <button type="button" class="removeAttribute btn btn-primary m-2">Remove</button>
                    </div>
                `);
                attr++;
                                $('#attributesContainer .select2').last().select2();
                            });
                            $('#attributesContainer').on('click', '.createattribute', function () {
                                $('#attributeModal').modal('show');
                            });

                            $('#attributesContainer').on('click', '.removeAttribute', function () {
                                $(this).closest('.attribute').remove();
                            });

                            // Handle save attribute
                            $('#saveattribute').click(function () {
                                var attrName = $('#attr_name').val();
                                var attrValue = $('#attr_value').val();
                                var attrPrice = $('#attr_price').val();
                                var attrStock = $('#attr_stock').val();
                                var formData = new FormData();
                                formData.append('attr_name', attrName);
                                formData.append('attr_value', attrValue);
                                formData.append('attr_price', attrPrice);
                                formData.append('attr_stock', attrStock);
                                formData.append('attr_image', $('#attr_image')[0].files[0]);

                                $.ajax({
                                    url: '/attributecreate',
                                    method: 'POST',
                                    data: formData,
                                    processData: false,
                                    contentType: false,
                                    success: function (data) {
                                        $('#attributeModal').modal('hide');
                                        $('#attr_name').val('');
                                        $('#attr_value').val('');
                                        $('#attr_price').val('');
                                        $('#attr_stock').val('');
                                        $('#attr_image').val('');
                                        $('.refreshattribute').click(); // Refresh the attributes
                                    }
                                });
                            });
                            // Function to remove attribute fields
                            $(document).on('click', '.removeAttribute', function () {
                                $(this).closest('.attribute').remove();
                            });

                            // Handle form submission
                            $('#productForm').submit(function (event) {
                                event.preventDefault(); // Prevent the default form submission

                                const formData = $(this).serializeArray();
                                const productData = {
                                    name: formData.find(field => field.name === 'name').value,
                                    description: formData.find(field => field.name === 'description').value,
                                    price: formData.find(field => field.name === 'price').value,
                                    attributes: []
                                };

                                formData.filter(field => field.name.startsWith('attributes')).forEach((field, index) => {
                                    const [_, attrIndex, attrField] = field.name.match(/attributes\[(\d+)]\[(\w+)]/);
                                    if (!productData.attributes[attrIndex]) {
                                        productData.attributes[attrIndex] = {};
                                    }
                                    productData.attributes[attrIndex][attrField] = field.value;
                                });

                                $.ajax({
                                    url: '/products',
                                    method: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify(productData),
                                    success: function (response) {
                                        alert('Product saved successfully');
                                        // Clear the form or handle the response as needed
                                    },
                                    error: function (err) {
                                        console.error('Error saving product:', err);
                                    }
                                });
                            });

                        });
                    </script>
                    <script src="../../assets/vendor/libs/hammer/hammer.js"></script>
                    <script src="../../assets/vendor/libs/i18n/i18n.js"></script>
                    <script src="../../assets/vendor/libs/typeahead-js/typeahead.js"></script>
                    <script src="../../assets/vendor/js/menu.js"></script>
                    <script src="../../assets/vendor/libs/bs-stepper/bs-stepper.js"></script>
                    <script src="../../assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
                    <script src="../../assets/vendor/libs/select2/select2.js"></script>
                    <script src="../../assets/vendor/libs/@form-validation/popular.js"></script>
                    <script src="../../assets/vendor/libs/@form-validation/bootstrap5.js"></script>
                    <script src="../../assets/vendor/libs/@form-validation/auto-focus.js"></script>
                    <script src="../../assets/js/form-wizard-numbered.js"></script>
                    <script src="../../assets/js/form-wizard-validation.js"></script>
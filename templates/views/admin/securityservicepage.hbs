{{>adminhead}}

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      {{>adminsidebar}}
      <div class="layout-page">
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> Service Pages</h4>
            {{#if message}}
            <div class="alert alert-success">{{message}}</div>
            {{/if}}
            <a href="/createsecurityservicepage" class="btn btn-primary waves-effect waves-light mb-2">Add Service Page</a>
            <div class="card">
              <div class="card-datatable text-nowrap">
                <table class="table" id="security-service-table">
                  <thead>
                    <tr>
                      <th>Title</th>
                      <th>Slug</th>
                      <th>Main category</th>
                      <th>Subcategory</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>
          </div>
          {{>adminfooter}}
          <script>
            $(document).ready(function () {
              $('#security-service-table').DataTable({
                processing: true,
                serverSide: true,
                ajax: { url: '/securityservicepages', type: 'GET' },
                columns: [
                  { data: 'title' },
                  { data: 'slug' },
                  { data: 'main_category', defaultContent: '' },
                  { data: 'subcategory', defaultContent: '' },
                  { data: 'status' },
                  {
                    data: '_id',
                    render: function (data) {
                      return '<a class="btn btn-sm btn-primary" href="/createsecurityservicepage/' + data + '">Edit</a> ' +
                        '<button type="button" class="btn btn-sm btn-danger" onclick="deleteServicePage(\'' + data + '\')">Delete</button>';
                    }
                  }
                ]
              });
            });

            function deleteServicePage(id) {
              if (confirm('Delete this service page?')) {
                window.location.href = '/deletesecurityservicepage/' + id;
              }
            }
          </script>

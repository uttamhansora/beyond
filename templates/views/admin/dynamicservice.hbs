        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createdynamicservice';
  }

  $(document).ready(function () {
  $('#dynamicservices-table').DataTable({
    "processing": true,
    "serverSide": true,
    "ajax": {
      "url": '/dynamicservices',
      "type": "GET"
    },
    "columns": [
      { "data": "title" },
      { 
        "data": "_id",
        "render": function (data, type, row) {
          return '<button type="button" class="btn btn-sm btn-primary" onclick="editBlog(\'' + data + '\')">Edit</button>' +
                 ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteBlog(\'' + data + '\')">Delete</button>';
        }
      }
    ]
  });


});


  function editBlog(id) {
    window.location.href = '{{url}}createdynamicservice/' + id;
  }

  function deleteBlog(id) {
    if (confirm('Are you sure you want to delete this Dynamic Service?')) {
                      $.ajax({
                        url: `/deletedynamicservice/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#dynamicservices-table').DataTable().ajax.reload();
                          alert('Dynamic Service deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting product:', err);
                          alert('Error deleting product');
                        }
                      });
                    }
  }
</script>
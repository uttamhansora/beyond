    <option value="hiperf" {{#if (eq team.category 'hiperf')}}selected{{/if}}>Hi-Perfomance Organization</option>
    <option value="leadership" {{#if (eq team.category 'leadership')}}selected{{/if}}>Leadership Exelence</option>
    <option value="stratagic" {{#if (eq team.category 'stratagic')}}selected{{/if}}>Stratagic HR</option>

  </select>
</div>
                      <div class="mb-3">

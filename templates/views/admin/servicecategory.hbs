        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createservicecategory';
  }

  $(document).ready(function() {
    $('#servicecategorys-table').DataTable({
  "processing": true,
  "serverSide": true,
  "ajax": {
    "url": $('#servicecategorys-table').data('url'), // URL for fetching data
    "type": "GET"
  },
  "columns": [
      {"data":"name"},
    { 
      "data": "image",
      "render": function(data, type, row) {
        return '<img src="' + data + '" class="img-fluid" style="max-width: 70px; max-height: 70px;background-color: black;" alt="Client Image">';
      }
    },
    { 
      "data": "_id",
      "render": function(data, type, row) {
        return '<button type="button" class="btn btn-sm btn-primary" onclick="editClient(\'' + data + '\')">Edit</button>' +
               ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteClient(\'' + data + '\')">Delete</button>';
      }
    }
  ]
});
  });

  function editClient(id) {
    window.location.href = '{{url}}createservicecategory/' + id;
  }

  function deleteClient(id) {
   if (confirm('Are you sure you want to delete this ServiceCategory?')) {
                      $.ajax({
                        url: `/ServiceCategory/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#servicecategorys-table').DataTable().ajax.reload();
                          alert('ServiceCategory deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting ServiceCategory:', err);
                          alert('Error deleting ServiceCategory');
                        }
                      });
                    }
  }
</script>
          </script>
        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createclient';
  }

  $(document).ready(function() {
    $('#clients-table').DataTable({
  "processing": true,
  "serverSide": true,
  "ajax": {
    "url": $('#clients-table').data('url'), // URL for fetching data
    "type": "GET"
  },
  "columns": [
    { 
      "data": "image",
      "render": function(data, type, row) {
        return '<img src="' + data + '" class="img-fluid" style="max-width: 70px; max-height: 70px;border-radius: 50%;background-color: black;" alt="Client Image">';
      }
    },
    { 
        "data": "order",
        "render": function (data, type, row) {
          return '<input type="number" class="form-control form-control-sm order-input" ' +
                 'data-id="' + row._id + '" value="' + (data || 0) + '" style="width:80px;">';
        }
      },
    { 
      "data": "_id",
      "render": function(data, type, row) {
        return '<button type="button" class="btn btn-sm btn-primary" onclick="editClient(\'' + data + '\')">Edit</button>' +
               ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteClient(\'' + data + '\')">Delete</button>';
      }
    }
  ]
});
$(document).on('change', '.order-input', function () {
    const id = $(this).data('id');
    const newOrder = $(this).val();

    $.ajax({
      url: $('#clients-table').data('url'),
      type: 'POST',
      data: { id: id, order: newOrder },
      success: function (res) {
        console.log('Order updated:', res);
      }
    });
  });
  });

  function editClient(id) {
    window.location.href = '{{url}}createclient/' + id;
  }

  function deleteClient(id) {
    if (confirm('Are you sure you want to delete this client?')) {
      // Implement the delete action here
      alert('Client with ID ' + id + ' deleted.');
    }
  }
</script>
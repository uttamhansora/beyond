            <!-- Ajax Sourced Server-side -->
            <div class="card">
              {{!-- <h5 class="card-header">Ajax Sourced Server-side</h5> --}}

              <div class="card-datatable text-nowrap">
                <table class="table" id="clients-table" data-url="clients">
                  <thead>
                    <tr>
                        
                      <th>Image</th>
                      <th>Order</th>
                      <th>Action</th>
                    </tr>
                  </thead>

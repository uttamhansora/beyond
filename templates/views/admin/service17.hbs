{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard /</span> Create Leadership Development
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/service17store" method="post" enctype="multipart/form-data">
                      {{#if team._id}}
                      <input type="hidden" name="id" value="{{team._id}}">
                      {{/if}}
<div class="mb-3">
        <label class="form-label" for="section_1_image">Background Image</label>
        <input type="file" name="bg_image" class="form-control" id="bg_image" />
        {{#if team.bg_image}}
        <a href="{{team.bg_image}}" target="_blank" class="openimage">View Image</a>
        {{/if}}
    </div>
                      <!-- Name -->
                      <div class="mb-3">
                        <label class="form-label" for="name">Name</label>
                        <input type="text" name="name" class="form-control" value="{{team.name}}" id="name" placeholder="Name" />
                      </div>

                      <!-- Main Title -->
                      <div class="mb-3">
                        <label class="form-label" for="main_title">Main Title</label>
                        <input type="text" name="main_title" class="form-control" value="{{team.main_title}}" id="main_title" placeholder="Main Title" />
                      </div>

                      <!-- Description -->
                      <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea name="description" class="form-control" id="description" placeholder="Description">{{team.description}}</textarea>
                      </div>

                      <!-- Section 1 Title -->
                      <div class="mb-3">
                        <label class="form-label" for="section_1_title">Section 1 Title</label>
                        <input type="text" name="section_1_title" class="form-control" value="{{team.section_1_title}}" id="section_1_title" placeholder="Section 1 Title" />
                      </div>

                      <!-- Section 1 Description -->
                      <div class="mb-3">
                        <label class="form-label" for="section_1_description">Section 1 Description</label>
                        <textarea name="section_1_description" class="form-control" id="section_1_description" placeholder="Section 1 Description">{{team.section_1_description}}</textarea>
                      </div>

                      <!-- Section 1 Image -->
                      <div class="mb-3">
                        <label class="form-label" for="section_1_image">Section 1 Image</label>
                        <input type="file" name="section_1_image" class="form-control" id="section_1_image">
                        {{#if team.section_1_image}}
                        <a href="javascript:void(0)" image-path="{{team.section_1_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <!-- Section 2 Title -->
                      <div class="mb-3">
                        <label class="form-label" for="section_2_title">Section 2 Title</label>
                        <input type="text" name="section_2_title" class="form-control" value="{{team.section_2_title}}" id="section_2_title" placeholder="Section 2 Title" />
                      </div>

                      <!-- Section 2 Image -->
                      <div class="mb-3">
                        <label class="form-label" for="section_2_image">Section 2 Image</label>
                        <input type="file" name="section_2_image" class="form-control" id="section_2_image">
                        {{#if team.section_2_image}}
                        <a href="javascript:void(0)" image-path="{{team.section_2_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <!-- Section 2 Description -->
                      <div class="mb-3">
                        <label class="form-label" for="section_2_description">Section 2 Description</label>
                        <textarea name="section_2_description" class="form-control" id="section_2_description" placeholder="Section 2 Description">{{team.section_2_description}}</textarea>
                      </div>

                      <!-- Components Title -->
                      <div class="mb-3">
                        <label class="form-label" for="components_title">Components Title</label>
                        <input type="text" name="components_title" class="form-control" value="{{team.components_title}}" id="components_title" placeholder="Components Title" />
                      </div>

                      <!-- Components Description -->
                      <div class="mb-3">
                        <label class="form-label" for="components_description">Components Description</label>
                        <textarea name="components_description" class="form-control" id="components_description" placeholder="Components Description">{{team.components_description}}</textarea>
                      </div>

                      <!-- Different Title -->
                      <div class="mb-3">
                        <label class="form-label" for="diffrent_title">Different Title</label>
                        <input type="text" name="diffrent_title" class="form-control" value="{{team.diffrent_title}}" id="diffrent_title" placeholder="Different Title" />
                      </div>

                      <!-- FAQ Title -->
                      <div class="mb-3">
                        <label class="form-label" for="faq_title">FAQ Title</label>
                        <input type="text" name="faq_title" class="form-control" value="{{team.faq_title}}" id="faq_title" placeholder="FAQ Title" />
                      </div>
<div class="mb-3">
                        <label class="form-label">Select Clients</label>
                        <select id="select2-dropdown" class="form-control" name="clients[]" style="width: 100%;" multiple>
                          {{#each client}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.clients)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Select Testimonials</label>
                        <select id="select2-dropdowns" class="form-control" name="testimonials[]" style="width: 100%;" multiple>
                          {{#each testimonial}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.testimonials)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
                       <div class="mb-3">
                        <label class="form-label">Select Case Study</label>
                        <select id="select2-dropdowncs" class="form-control" name="service_casestudy[]" style="width: 100%;" multiple>
                          {{#each casestudy}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.service_casestudy)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
                      <!-- Submit Button -->
                      <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{>adminfooter}}
          
         
        </div>
      </div>
    </div>
  </div>
</body>

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> Downloads</h4>
            <button type="button" class="btn btn-primary waves-effect waves-light mb-2"
              onclick="redirectToUrl('{{url}}')">Add Download</button>
            <!-- Ajax Sourced Server-side -->
            <div class="card">
              {{!-- <h5 class="card-header">Ajax Sourced Server-side</h5> --}}

              <div class="card-datatable text-nowrap">
                <table class="table responsive" id="downloads-table" data-url="downloads">
                  <thead>
                    <tr>
                      <th>Download Title</th>
                      <th>Order</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>
          </div>
          {{>adminfooter}}
          <script>
            function redirectToUrl(url) {
              window.location.href = url + 'createdownload';
            }
           
          </script>
        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createdownload';
  }

  $(document).ready(function () {
  $('#downloads-table').DataTable({
    "processing": true,
    "serverSide": true,
    "ajax": {
      "url": $('#downloads-table').data('url'),
      "type": "GET"
    },
    "columns": [
      { "data": "title" },
      { 
        "data": "order",
        "render": function (data, type, row) {
          return '<input type="number" class="form-control form-control-sm order-input" ' +
                 'data-id="' + row._id + '" value="' + (data || 0) + '" style="width:80px;">';
        }
      },
      { 
        "data": "_id",
        "render": function (data, type, row) {
          return '<button type="button" class="btn btn-sm btn-primary" onclick="editBlog(\'' + data + '\')">Edit</button>' +
                 ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteBlog(\'' + data + '\')">Delete</button>';
        }
      }
    ]
  });

  // Handle order change
  $(document).on('change', '.order-input', function () {
      showToast("Order Updated",'success')
    const id = $(this).data('id');
    const newOrder = $(this).val();

    $.ajax({
      url: $('#downloads-table').data('url'),
      type: 'POST',
      data: { id: id, order: newOrder },
      success: function (res) {
        console.log('Order updated:', res);
      }
    });
  });
});


  function editBlog(id) {
    window.location.href = '{{url}}createdownload/' + id;
  }

  function deleteBlog(id) {
    if (confirm('Are you sure you want to delete this Download?')) {
                      $.ajax({
                        url: `/deletedownload/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#downloads-table').DataTable().ajax.reload();
                          alert('Download deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting product:', err);
                          alert('Error deleting product');
                        }
                      });
                    }
  }
</script>
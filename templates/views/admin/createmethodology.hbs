{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Create Methodology
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/storemethodology" method="post">
                    {{#if team._id}}
                    <input type="hidden" name="id" value="{{team._id}}">
                    {{/if}}
                   
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-fullname">Methodology Heading</label>
                        <input type="text" name="heading" class="form-control" value="{{team.heading}}" id="basic-default-fullname"
                          placeholder="Methodology Heading" />
                      </div>
                       
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-company">Title</label>
                        <input type="text" name="title" value="{{team.title}}" class="form-control" id="basic-default-company"
                          placeholder="Title" />
                      </div>
                     
                      <div class="mb-3">
                        <label class="form-label" for="basic-default-message">Content</label>
                        <textarea id="editor" class="form-control" name="description" placeholder="Content">{{team.description}}</textarea>
                      </div>
                      <button type="submit" class="btn btn-primary">Submit</button>
                      <a href="/dashboard" class="btn btn-danger">Cancel</a>
                    </form>
                  </div>
                </div>
              </div>

            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false, // Disable auto grow
                  // Your other CKEditor configuration options...
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
  <!-- JavaScript for auto-generating the slug -->
  <script>
    function generateSlug() {
      var name = document.querySelector('input[name="name"]').value;
      var slugField = document.querySelector('input[name="slug"]');
      
      // Generate slug by converting name to lowercase and replacing spaces with hyphens
      var slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      
      // Set the generated slug in the slug field
      slugField.value = slug;
    }
  </script>

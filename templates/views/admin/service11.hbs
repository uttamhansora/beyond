{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->
        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard /</span>
              Create Future Leader Entry
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/service11store" method="post" enctype="multipart/form-data">
                      {{#if team._id}}
                        <input type="hidden" name="id" value="{{team._id}}">
                      {{/if}}
<div class="mb-3">
        <label class="form-label" for="section_1_image">Background Image</label>
        <input type="file" name="bg_image" class="form-control" id="bg_image" />
        {{#if team.bg_image}}
        <a href="{{team.bg_image}}" target="_blank" class="openimage">View Image</a>
        {{/if}}
    </div>
                      <!-- Basic Fields -->
                      <div class="mb-3">
                        <label class="form-label" for="name">Name</label>
                        <input type="text" name="name" class="form-control" value="{{team.name}}" id="name" placeholder="Name" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="main_title">Main Title</label>
                        <input type="text" name="main_title" class="form-control" value="{{team.main_title}}" id="main_title" placeholder="Main Title" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea name="description" class="form-control"  placeholder="Description">{{team.description}}</textarea>
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="serviceType">Service Type</label>
                        <input type="text" name="serviceType" class="form-control" value="{{team.serviceType}}" id="serviceType" placeholder="Service Type" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="serviceName">Service Name</label>
                        <input type="text" name="serviceName" class="form-control" value="{{team.serviceName}}" id="serviceName" placeholder="Service Name" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="section_1_description">Section 1 Description</label>
                        <textarea name="section_1_description" class="form-control" id="identify_description" placeholder="Section 1 Description">{{team.section_1_description}}</textarea>
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="section_1_image">Section 1 Image</label>
                        <input type="file" name="section_1_image" class="form-control">
                        {{#if team.section_1_image}}
                          <a href="javascript:void(0)" image-path="{{team.section_1_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <!-- Identify Section -->
                      <div class="mb-3">
                        <label class="form-label" for="identify_title">Identify Title</label>
                        <input type="text" name="identify_title" class="form-control" value="{{team.identify_title}}" id="identify_title" placeholder="Identify Title" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_description">Identify Description</label>
                        <textarea name="identify_description" class="form-control"  placeholder="Identify Description">{{team.identify_description}}</textarea>
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_1_image">Identify 1 Image</label>
                        <input type="file" name="identify_1_image" class="form-control">
                        {{#if team.identify_1_image}}
                          <a href="javascript:void(0)" image-path="{{team.identify_1_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_1_title">Identify 1 Title</label>
                        <input type="text" name="identify_1_title" class="form-control" value="{{team.identify_1_title}}" id="identify_1_title" placeholder="Identify 1 Title" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_2_image">Identify 2 Image</label>
                        <input type="file" name="identify_2_image" class="form-control">
                        {{#if team.identify_2_image}}
                          <a href="javascript:void(0)" image-path="{{team.identify_2_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_2_title">Identify 2 Title</label>
                        <input type="text" name="identify_2_title" class="form-control" value="{{team.identify_2_title}}" id="identify_2_title" placeholder="Identify 2 Title" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_3_image">Identify 3 Image</label>
                        <input type="file" name="identify_3_image" class="form-control">
                        {{#if team.identify_3_image}}
                          <a href="javascript:void(0)" image-path="{{team.identify_3_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="identify_3_title">Identify 3 Title</label>
                        <input type="text" name="identify_3_title" class="form-control" value="{{team.identify_3_title}}" id="identify_3_title" placeholder="Identify 3 Title" />
                      </div>

                      <!-- Process Section -->
                      <div class="mb-3">
                        <label class="form-label" for="process_title">Process Title</label>
                        <input type="text" name="process_title" class="form-control" value="{{team.process_title}}" id="process_title" placeholder="Process Title" />
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="process_description">Process Description</label>
                        <textarea name="process_description" class="form-control" id="process_description" placeholder="Process Description">{{team.process_description}}</textarea>
                      </div>

                      <div class="mb-3">
                        <label class="form-label" for="edge_title">Edge Title</label>
                        <input type="text" name="edge_title" class="form-control" value="{{team.edge_title}}" id="edge_title" placeholder="Edge Title" />
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Select Clients</label>
                        <select id="select2-dropdown" class="form-control" name="clients[]" style="width: 100%;" multiple>
                          {{#each client}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.clients)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
 <div class="mb-3">
                        <label class="form-label">Select Case Study</label>
                        <select id="select2-dropdowncs" class="form-control" name="service_casestudy[]" style="width: 100%;" multiple>
                          {{#each casestudy}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.service_casestudy)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
                      <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
            
              ClassicEditor
                .create(document.querySelector('#identify_description'), {
                  autoGrow: false,
                })
                .then(editor => editor.ui.view.editable.element.style.height = '200px')
                .catch(error => console.error(error));
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</body>

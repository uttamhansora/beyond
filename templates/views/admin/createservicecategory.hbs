{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Create Service Category
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/storeservicecategory" method="post" enctype="multipart/form-data">
                     {{#if team._id}}
  <input type="hidden" name="id" value="{{team._id}}">
  {{/if}}

  <div class="mb-3">
      <label class="form-label" for="basic-default-image">Name</label>
      <input type="text" name="name" class="form-control" value="{{team.name}}">
     
    </div>

    
     <div class="mb-3">
      <label class="form-label" for="basic-default-image">Image</label>
      <input type="file" name="image" class="form-control">
      {{#if team.image}}
      <a target="_blank" href="{{team.image}}" class="openimage ">View Image</a>
      {{/if}}
    </div>

<div class="mb-3">
      <label class="form-label" for="basic-default-client-logo">Pdf</label>
      <input type="file" name="pdf" class="form-control">
      {{#if team.pdf}}
      <a target="_blank" href="{{url}}{{team.pdf}}" class="openimage">View PDF</a>
      {{/if}}
    </div>


  <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                  </div>
                </div>
              </div>

            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false, // Disable auto grow
                  // Your other CKEditor configuration options...
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
          <script>
  document.addEventListener('DOMContentLoaded', function () {
    const formatSelect = document.getElementById('format-select');
    const descriptionFields = document.getElementById('description-fields');
    const youtubeFields = document.getElementById('youtube-fields');

    // Show the correct fields based on initial selection
    toggleFields(formatSelect.value);

    // Listen to the change event on the select dropdown
    formatSelect.addEventListener('change', function () {
      toggleFields(this.value);
    });

    function toggleFields(format) {
      if (format === 'Description') {
        descriptionFields.style.display = 'block';
        youtubeFields.style.display = 'none';
      } else if (format === 'Youtube') {
        descriptionFields.style.display = 'none';
        youtubeFields.style.display = 'block';
      }
    }
  });
</script>
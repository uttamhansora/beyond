    {{!-- Start Model Code --}}

    <div class="modal fade" id="audienceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Audience</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col mb-3">
                            <label for="audience_name">Name:</label>
                            <input type="text" class="form-control" id="audience_name">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col mb-3">
                            <label for="audience_image">Image:</label>
                            <input type="file" class="form-control" id="audience_image">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col mb-3">
                            <label for="audience_description_1">Description:</label>
                            <textarea class="form-control" id="audience_description_1"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" id="saveAudienceButton" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="benefitModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Benefit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col mb-3">

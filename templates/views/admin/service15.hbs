{{>adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->

      {{>adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Navbar -->

        <!-- / Navbar -->

        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard /</span> Create HR Excellence
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/service15store" method="post" enctype="multipart/form-data">
                      {{#if team._id}}
                      <input type="hidden" name="id" value="{{team._id}}">
                      {{/if}}
<div class="mb-3">
        <label class="form-label" for="section_1_image">Background Image</label>
        <input type="file" name="bg_image" class="form-control" id="bg_image" />
        {{#if team.bg_image}}
        <a href="{{team.bg_image}}" target="_blank" class="openimage">View Image</a>
        {{/if}}
    </div>
                      <!-- Name -->
                      <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" value="{{team.name}}" placeholder="Name" />
                      </div>

                      <!-- Main Title -->
                      <div class="mb-3">
                        <label class="form-label">Main Title</label>
                        <input type="text" name="main_title" class="form-control" value="{{team.main_title}}" placeholder="Main Title" />
                      </div>

                    
                      <!-- Description -->
                      <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" name="description" placeholder="Description">{{team.description}}</textarea>
                      </div>

                      <!-- Section 1 Title -->
                      <div class="mb-3">
                        <label class="form-label">Section 1 Title</label>
                        <input type="text" name="section_1_title" class="form-control" value="{{team.section_1_title}}" placeholder="Section 1 Title" />
                      </div>

                      <!-- Section 1 Description -->
                      <div class="mb-3">
                        <label class="form-label">Section 1 Description</label>
                        <textarea class="form-control " id="editor" name="section_1_description" placeholder="Section 1 Description">{{team.section_1_description}}</textarea>
                      </div>

                      <!-- Section 1 Image -->
                      <div class="mb-3">
                        <label class="form-label">Section 1 Image</label>
                        <input type="file" name="section_1_image" class="form-control">
                        {{#if team.section_1_image}}
                        <a href="javascript:void(0)" image-path="{{team.section_1_image}}" class="openimage">View Image</a>
                        {{/if}}
                      </div>

                      <!-- Colleague Title -->
                      <div class="mb-3">
                        <label class="form-label">Colleague Title</label>
                        <input type="text" name="colleage_title" class="form-control" value="{{team.colleage_title}}" placeholder="Colleague Title" />
                      </div>

                      <!-- Colleague Description -->
                      <div class="mb-3">
                        <label class="form-label">Colleague Description</label>
                        <textarea class="form-control" name="colleage_description" placeholder="Colleague Description">{{team.colleage_description}}</textarea>
                      </div>

                      <!-- Report Title -->
                      <div class="mb-3">
                        <label class="form-label">Report Title</label>
                        <input type="text" name="report_title" class="form-control" value="{{team.report_title}}" placeholder="Report Title" />
                      </div>

                      <!-- Report Heading -->
                      <div class="mb-3">
                        <label class="form-label">Report Heading</label>
                        <input type="text" name="report_heading" class="form-control" value="{{team.report_heading}}" placeholder="Report Heading" />
                      </div>

                      <!-- Report Description -->
                      <div class="mb-3">
                        <label class="form-label">Report Description</label>
                        <textarea class="form-control" name="report_description" placeholder="Report Description">{{team.report_description}}</textarea>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Select Clients</label>
                        <select id="select2-dropdown" class="form-control" name="clients[]" style="width: 100%;" multiple>
                          {{#each client}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.clients)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
 <div class="mb-3">
                        <label class="form-label">Select Case Study</label>
                        <select id="select2-dropdowncs" class="form-control" name="service_casestudy[]" style="width: 100%;" multiple>
                          {{#each casestudy}}
                          
  <option value="{{this._id}}" data-image="{{url}}{{this.image}}" {{#if (contains this._id ../team.service_casestudy)}}selected{{/if}}>{{this.name}}</option>
                          {{/each}}
</select>
                      </div>
                      <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {{>adminfooter}}
          <script src="https://cdn.ckeditor.com/ckeditor5/33.0.0/classic/ckeditor.js"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              ClassicEditor
                .create(document.querySelector('#editor'), {
                  autoGrow: false,
                })
                .then(editor => {
                  editor.ui.view.editable.element.style.height = '400px';
                  console.log(editor);
                })
                .catch(error => {
                  console.error(error);
                });
            });
          </script>
        </div>
      </div>
    </div>
  </div>
</body>

          <script>
            function addRow(containerId, templateId) {
              var box = document.getElementById(containerId);
              var index = box.dataset.next || '0';
              box.dataset.next = String(Number(index) + 1);
              var html = document.getElementById(templateId).innerHTML.split('__i__').join(index);
              box.insertAdjacentHTML('beforeend', html);
            }
            function removeRow(button) {
              var row = button.closest('.repeater-row');
              if (row) row.remove();
            }
            function syncSubcategories() {
              var main = document.getElementById('main-category');
              var sub = document.getElementById('subcategory');
              if (!main || !sub) return;
              var first = '';
              Array.prototype.forEach.call(sub.options, function (option) {
                var show = option.getAttribute('data-main') === main.value;
                option.hidden = !show;
                option.disabled = !show;
                if (show && !first) first = option.value;
              });
              if (sub.selectedOptions.length && sub.selectedOptions[0].disabled) sub.value = first;
            }
            var mainCategory = document.getElementById('main-category');
            if (mainCategory) {
              mainCategory.addEventListener('change', syncSubcategories);
              syncSubcategories();
            }
          </script>

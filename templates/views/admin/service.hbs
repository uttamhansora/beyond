        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createservice';
  }

  $(document).ready(function() {
    $('#services-table').DataTable({
      "processing": true,
      "serverSide": true,
      "ajax": {
        "url": $('#services-table').data('url'),
        "type": "GET"
      },
      "columns": [
        { "data": "name" },
        { "data": "title" },
        { 
          "data": "_id",
          "render": function(data, type, row) {
            return '<button type="button" class="btn btn-sm btn-primary" onclick="editBlog(\'' + data + '\')">Edit</button>' +
                   ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteBlog(\'' + data + '\')">Delete</button>';
          }
        }
      ]
    });
  });

  function editBlog(id) {
    window.location.href = '{{url}}createservice/' + id;
  }

  function deleteBlog(id) {
    if (confirm('Are you sure you want to delete this blog?')) {
      // Implement the delete action here
      alert('Blog with ID ' + id + ' deleted.');
    }
  }
</script>
{{> adminhead}}

<body>
  <!-- Layout wrapper -->
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
      <!-- Menu -->
      {{> adminsidebar}}
      <!-- / Menu -->

      <!-- Layout container -->
      <div class="layout-page">
        <!-- Content wrapper -->
        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard/</span>
              Page Title Settings
            </h4>
            <div class="row">
              <div class="col-xl">
                <div class="card mb-4">
                  <div class="card-body">
                    <form action="/mainservicestore" method="post" enctype="multipart/form-data">
                      {{#if team._id}}
                      <input type="hidden" name="id" value="{{team._id}}">
                      {{/if}}

         <div class="mb-3">
    <label class="form-label" for="name">Name</label>
    <input type="text" name="name" class="form-control" id="name" placeholder="Enter Name" value="{{team.name}}" />
</div>
<div class="mb-3">
    <label class="form-label" for="main_title">Main Title</label>
    <input type="text" name="main_title" class="form-control" id="main_title" placeholder="Enter Main Title" value="{{team.main_title}}" />
</div>
<div class="mb-3">
    <label class="form-label" for="description">Description</label>
    <textarea name="description" class="form-control" id="description" placeholder="Enter Description">{{team.description}}</textarea>
</div>
<div class="mb-3">
    <label class="form-label" for="slug">Slug</label>
    <input type="text" name="slug" class="form-control" id="slug" placeholder="Enter Slug" value="{{team.slug}}" />
</div>

  <div class="mb-3">
        <label class="form-label" for="section_1_image">Background Image</label>
        <input type="file" name="bg_image" class="form-control" id="bg_image" />
        {{#if team.bg_image}}
        <a href="{{team.bg_image}}" target="_blank" class="openimage">View Image</a>
        {{/if}}
    </div>
<!-- Title 1 -->
<div class="mb-3">
  <label class="form-label" for="title_1"><strong>Title 1</strong></label>
  <input type="text" name="title_1" class="form-control" value="{{team.title_1}}" placeholder="Enter Title 1" required />
</div>

<!-- Image 1 -->
<div class="mb-3">
  <label class="form-label" for="image_1"><strong>Image 1</strong></label>
  <input type="file" name="image_1" class="form-control" {{#if team.image_1}}{{else}}{{/if}} />
  {{#if team.image_1}}
    <a href="javascript:void(0)" image-path="{{team.image_1}}" class="openimage">View Image</a>
  {{/if}}
</div>

<!-- Title 2 -->
<div class="mb-3">
  <label class="form-label" for="title_2"><strong>Title 2</strong></label>
  <input type="text" name="title_2" class="form-control" value="{{team.title_2}}" placeholder="Enter Title 2" required />
</div>

<!-- Image 2 -->
<div class="mb-3">
  <label class="form-label" for="image_2"><strong>Image 2</strong></label>
  <input type="file" name="image_2" class="form-control" {{#if team.image_2}}{{else}}{{/if}} />
  {{#if team.image_2}}
    <a href="javascript:void(0)" image-path="{{team.image_2}}" class="openimage">View Image</a>
  {{/if}}
</div>


                      <!-- Submit Button -->
                      <button type="submit" class="btn btn-primary">Save</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {{> adminfooter}}
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript for auto-generating the slug -->
  <script>
    function generateSlug() {
      var name = document.querySelector('input[name="name"]').value;
      var slugField = document.querySelector('input[name="slug"]');
      
      // Generate slug by converting name to lowercase and replacing spaces with hyphens
      var slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      
      // Set the generated slug in the slug field
      slugField.value = slug;
    }
  </script>
</body>

          </script>
        <script>
  function redirectToUrl(url) {
    window.location.href = url + 'createteam';
  }

  $(document).ready(function() {
    $('#teams-table').DataTable({
      "processing": true,
      "serverSide": true,
      "ajax": {
        "url": $('#teams-table').data('url'),
        "type": "GET"
      },
      "columns": [
        { "data": "f_name" },
        { 
        "data": "order",
        "render": function (data, type, row) {
          return '<input type="number" class="form-control form-control-sm order-input" ' +
                 'data-id="' + row._id + '" value="' + (data || 0) + '" style="width:80px;">';
        }
      },
        { 
          "data": "_id",
          "render": function(data, type, row) {
            return '<button type="button" class="btn btn-sm btn-primary" onclick="editBlog(\'' + data + '\')">Edit</button>' +
                   ' <button type="button" class="btn btn-sm btn-danger" onclick="deleteBlog(\'' + data + '\')">Delete</button>';
          }
        }
      ]
    });
    $(document).on('change', '.order-input', function () {
         showToast("Order Updated",'success')
    const id = $(this).data('id');
    const newOrder = $(this).val();

    $.ajax({
      url: $('#teams-table').data('url'),
      type: 'POST',
      data: { id: id, order: newOrder },
      success: function (res) {
         
        console.log('Order updated:', res);
      }
    });
  });
  });

  function editBlog(id) {
    window.location.href = '{{url}}createteam/' + id;
  }

  function deleteBlog(id) {
    if (confirm('Are you sure you want to delete this Blog?')) {
                      $.ajax({
                        url: `/deleteteam/${id}`, // Adjust the model name and endpoint as needed
                        type: 'GET',
                        success: function(result) {
                          // Reload the DataTable after successful deletion
                          $('#teams-table').DataTable().ajax.reload();
                          alert('Team deleted successfully');
                        },
                        error: function(err) {
                          console.error('Error deleting product:', err);
                          alert('Error deleting product');
                        }
                      });
                    }
  }
</script>
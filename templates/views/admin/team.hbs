          <div class="container-xxl flex-grow-1 container-p-y">
            <h4 class="py-3 mb-4"><span class="text-muted fw-light">Dashboard /</span> Teams</h4>
            <button type="button" class="btn btn-primary waves-effect waves-light mb-2"
              onclick="redirectToUrl('{{url}}')">Add Team</button>
            <!-- Ajax Sourced Server-side -->
            <div class="card">
              {{!-- <h5 class="card-header">Ajax Sourced Server-side</h5> --}}

              <div class="card-datatable text-nowrap">
                <table class="table responsive" id="teams-table" data-url="teams">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Order</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>

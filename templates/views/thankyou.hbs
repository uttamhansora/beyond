<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Success</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 50px;
        }
        h1 {
            color: #333;
        }
        p {
            color: #666;
            font-size: 18px;
        }
        .emoji {
            font-size: 48px;
        }
        .receipt {
            border: 1px solid #ccc;
            padding: 20px;
            margin-top: 30px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            background-color: #f9f9f9;
        }
        .item {
            margin-bottom: 10px;
        }
        .item strong {
            color: #333;
        }
    </style>
</head>
<body>
    <h1>Payment Successful!</h1>
    <p>Your payment has been processed successfully.</p>
    <p class="emoji">💳</p>

    
</body>
</html>

        closeOnSelect: false, // Keep dropdown open while selecting
        templateResult: formatOption, // Customize dropdown options
        templateSelection: formatSelection // Customize selected items
    });
     $('#select2-dropdowns').select2({
      placeholder:"Select Testimonials",
        multiple: true, // Enable multiple selection
        closeOnSelect: false, // Keep dropdown open while selecting
        templateResult: formatOption, // Customize dropdown options
        templateSelection: formatSelection // Customize selected items
    });
     $('#select2-dropdowncs').select2({
      placeholder:"Select Case Study",
        multiple: true, // Enable multiple selection
        closeOnSelect: false, // Keep dropdown open while selecting
        templateResult: formatOption, // Customize dropdown options
        templateSelection: formatSelection // Customize selected items
    });

    // Function to format dropdown options
    function formatOption(option) {
        if (!option.id) return option.text; // Default text for placeholder
        var imageUrl = $(option.element).data('image');
        return $(
            `<div style="display: flex; align-items: center;">
                <img src="${imageUrl}" style="width: 20px; height: 20px; margin-right: 10px;background-color:black" />
                ${option.text}
            </div>`
        );
    }

    // Function to format the selected items
    function formatSelection(option) {
        if (!option.id) return option.text;
        var imageUrl = $(option.element).data('image');
        return $(
            `<div style="display: flex; align-items: center;">
                <img src="${imageUrl}" style="width: 20px; height: 20px; margin-right: 10px;background-color:black" />
                ${option.text}
            </div>`
        );
    }
});
